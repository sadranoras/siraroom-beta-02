# --- Web app ---
PORT=3000
# Public address of this site (used for payment callbacks). Use https:// in production.
APP_URL=http://localhost:3000
# Set to 1 only if you run behind a reverse proxy (nginx/Caddy) so client IPs are read from X-Forwarded-For
TRUST_PROXY=0
# Optional. If empty, a random secret is generated and stored in data/.secret
SESSION_SECRET=

# --- LiveKit (video/audio engine) ---
# Address the BROWSER connects to (wss:// in production)
LIVEKIT_URL=ws://localhost:7880
# Address this server uses to call LiveKit's admin API (can be internal)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# --- First admin (created only if no admin exists). If password is empty one is generated and printed in the console ---
ADMIN_EMAIL=noras.sadra@gmail.com
ADMIN_PASSWORD=qazplm220?

# --- Payments (optional). Leave empty to use manual card-to-card approval from the admin panel ---
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=0

# --- Storage ---
DATA_DIR=./data
MAX_RECORDING_MB=1024
# Max size of an uploaded PDF/PowerPoint (MB)
MAX_FILE_MB=50
# Optional: full path to LibreOffice's soffice (needed only for PowerPoint conversion if it is not on PATH)
SOFFICE_PATH=
